// ─────────────────────────────────────────────────────────
// Prisma Schema – Log your Workout
// ─────────────────────────────────────────────────────────
// This file defines the database structure.
// After changes, run: npx prisma migrate dev
// ─────────────────────────────────────────────────────────

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // pooled connection – used at runtime
  directUrl = env("DIRECT_URL")     // direct connection – used for migrations
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────

// Role: determines what a user can do in the app.
// USER    = regular client / athlete
// TRAINER = fitness trainer or physiotherapist;
//           can manage clients, assign plans, view client progress
enum Role {
  USER
  TRAINER
}

// Visibility of a training plan.
// PRIVATE = only the owner can see it
// PUBLIC  = any logged-in user can find and view it
enum Visibility {
  PRIVATE
  PUBLIC
}

// Status of a trainer–client connection.
// PENDING = trainer has sent an invite, client not yet registered
// ACTIVE  = connection is live; trainer can assign plans and view progress
enum TrainerClientStatus {
  PENDING
  ACTIVE
}

// ─────────────────────────────────────────────────────────
// USER
// Managed by Supabase Auth – we mirror the user here
// so we can link workouts, plans etc. to a real user record.
// ─────────────────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      Role     @default(USER) // new: USER by default; set to TRAINER to unlock trainer features
  createdAt DateTime @default(now())

  trainingPlans   TrainingPlan[]
  workoutSessions WorkoutSession[]

  // Trainer side: clients this user manages
  clientRelations TrainerClient[] @relation("TrainerRelation")

  // Client side: trainers this user is connected to
  trainerRelations TrainerClient[] @relation("ClientRelation")

  // Plans assigned to this user by a trainer
  assignedPlans PlanAssignment[] @relation("AssignedToClient")

  // Plans this user (as trainer) has assigned to others
  assignedByMe  PlanAssignment[] @relation("AssignedByTrainer")

  // Comments this user (as trainer) has written on client sessions
  sessionComments SessionComment[] @relation("TrainerComments")
}

// ─────────────────────────────────────────────────────────
// TRAINER–CLIENT RELATIONSHIP
// Links a trainer to one of their clients.
// Created when a trainer invites a client by email.
// Status moves from PENDING → ACTIVE when the client registers
// (or immediately if the client already has an account).
// ─────────────────────────────────────────────────────────
model TrainerClient {
  id          String            @id @default(cuid())
  status      TrainerClientStatus @default(ACTIVE)
  inviteEmail String?           // used when client has no account yet
  createdAt   DateTime          @default(now())

  trainerId String
  trainer   User   @relation("TrainerRelation", fields: [trainerId], references: [id])

  clientId  String?             // null while status = PENDING (client not registered yet)
  client    User?  @relation("ClientRelation", fields: [clientId], references: [id])
}

// ─────────────────────────────────────────────────────────
// PLAN ASSIGNMENT
// Records that a trainer has assigned one of their plans
// to a specific client. The plan itself is never modified –
// the client gets a read-only view of the trainer's plan.
// ─────────────────────────────────────────────────────────
model PlanAssignment {
  id         String   @id @default(cuid())
  assignedAt DateTime @default(now())

  // The plan being assigned (must belong to the trainer)
  planId String
  plan   TrainingPlan @relation(fields: [planId], references: [id])

  // The trainer who made the assignment
  trainerId String
  trainer   User   @relation("AssignedByTrainer", fields: [trainerId], references: [id])

  // The client receiving the plan
  clientId String
  client   User   @relation("AssignedToClient", fields: [clientId], references: [id])

  // A trainer cannot assign the same plan to the same client twice
  @@unique([planId, clientId])
}

// ─────────────────────────────────────────────────────────
// EXERCISE
// A global catalog of exercises (Bankdrücken, Kniebeugen…).
// Independent of any user or plan.
// ─────────────────────────────────────────────────────────
model Exercise {
  id          String  @id @default(cuid())
  name        String
  muscleGroup String  // "Brust", "Beine", "Rücken", "Schultern"…
  description String?

  planExercises PlanExercise[]
  sets          Set[]
}

// ─────────────────────────────────────────────────────────
// TRAINING PLAN
// A named plan belonging to one user.
// Contains a list of exercises in a defined order.
// ─────────────────────────────────────────────────────────
model TrainingPlan {
  id          String     @id @default(cuid())
  name        String     // e.g. "Kraft Aufbau", "Push/Pull/Legs"
  description String?
  visibility  Visibility @default(PRIVATE)
  createdAt   DateTime   @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  planExercises   PlanExercise[]
  workoutSessions WorkoutSession[]
  assignments     PlanAssignment[]  // clients this plan has been assigned to
}

// ─────────────────────────────────────────────────────────
// PLAN EXERCISE  (join table: TrainingPlan ↔ Exercise)
// Resolves the many-to-many relationship.
// Stores order and target values for each exercise in a plan.
// ─────────────────────────────────────────────────────────
model PlanExercise {
  id         String @id @default(cuid())
  order      Int    // position in the plan: 1, 2, 3…
  targetSets Int?   // planned sets  (e.g. 4)
  targetReps Int?   // planned reps  (e.g. 8)

  planId String
  plan   TrainingPlan @relation(fields: [planId], references: [id])

  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
}

// ─────────────────────────────────────────────────────────
// WORKOUT SESSION
// One concrete training session on a specific date.
// Optionally linked to a training plan.
// ─────────────────────────────────────────────────────────
model WorkoutSession {
  id    String   @id @default(cuid())
  date  DateTime @default(now())
  notes String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  planId String?
  plan   TrainingPlan? @relation(fields: [planId], references: [id])

  sets     Set[]
  comments SessionComment[]
}

// ─────────────────────────────────────────────────────────
// SESSION COMMENT
// A trainer leaves a comment on a client's workout session.
// Visible to the client on their history page.
// ─────────────────────────────────────────────────────────
model SessionComment {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())

  // The session being commented on
  sessionId String
  session   WorkoutSession @relation(fields: [sessionId], references: [id])

  // The trainer who wrote the comment
  trainerId String
  trainer   User   @relation("TrainerComments", fields: [trainerId], references: [id])
}

// ─────────────────────────────────────────────────────────
// SET
// A single set within a workout session.
// This is where the actual numbers are recorded.
// ─────────────────────────────────────────────────────────
model Set {
  id       String  @id @default(cuid())
  order    Int     // 1st set, 2nd set, 3rd set…
  reps     Int     // actual reps performed
  weightKg Float?  // actual weight in kg (optional for bodyweight exercises)
  notes    String?

  sessionId String
  session   WorkoutSession @relation(fields: [sessionId], references: [id])

  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
}
