# Copy this file to .env and fill in your values.
# Never commit .env to Git.

# Database – Supabase PostgreSQL
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-eu-central-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-eu-central-2.pooler.supabase.com:5432/postgres"

# Supabase
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."

# Server
PORT=3001
WEB_URL=http://localhost:3000
